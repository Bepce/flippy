# Copy to .env and fill in. docker compose reads it.

# flippy version to run (a release tag without the v), or "latest"
FLIPPY_VERSION=0.4.0

# Palltex
PALLTEX_HOST=palltex.flippy.io
PALLTEX_SITE_NAME=Palltex catalogues
# the sites allowed to embed the catalogues (comma-separated); "*" allows any
PALLTEX_CORS=https://palltex.bg, https://www.palltex.bg
