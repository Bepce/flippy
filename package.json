{
  "name": "@bepce/flippy",
  "version": "0.4.0",
  "description": "Self-hosted page-turning catalogue viewer. Turn a PDF into a flipbook on your own site, with product links that keep your shop's cart working.",
  "license": "MIT",
  "author": "flippy contributors",
  "homepage": "https://github.com/Bepce/flippy#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Bepce/flippy.git" },
  "bugs": "https://github.com/Bepce/flippy/issues",
  "keywords": ["flipbook", "page-flip", "page-turn", "catalogue", "catalog", "pdf", "brochure", "magazine", "ecommerce", "web-component"],
  "main": "dist/flippy.js",
  "style": "dist/flippy.css",
  "unpkg": "dist/flippy.min.js",
  "jsdelivr": "dist/flippy.min.js",
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "dist": "node tools/build-dist.js",
    "serve": "python3 -m http.server 8080",
    "test": "node tests/smoke.js && node tests/builder.js",
    "test:builder": "node tests/builder.js",
    "test:server": "node tests/server.js",
    "package-server": "sh tools/package-server.sh",
    "sample": "node examples/hollowbrook/make.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.47.0"
  }
}
